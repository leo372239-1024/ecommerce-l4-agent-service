    {/* 左侧竖向强调块 */}
    <Box style={{ position: 'absolute', top: 64, left: 0, width: 10, height: 568, background: '#1E4FA8' }} />
    {/* 右上浅蓝装饰弧 */}
    <Box style={{ position: 'absolute', top: 64, right: 0, width: 300, height: 260, background: '#F0F5FC', borderBottomLeftRadius: 260 }} />

    {/* 封面主体 */}
    <Box style={{ position: 'absolute', top: 132, left: 84, width: 1120, flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, height: 36 }}>
            <Box style={{ padding: '6px 20px', background: '#E8EFF8', borderRadius: 18, border: '1px solid #C9DCF5' }}>
                <Text style={{ fontSize: 17, color: '#1E4FA8', fontWeight: 'bold', letterSpacing: 1 }}>课程项目开题答辩</Text>
            </Box>
            <Text style={{ fontSize: 16, color: '#8B97A8' }}>Research Proposal Defense</Text>
        </Box>

        <Text style={{ fontSize: 60, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.25, marginTop: 22 }}>电商 L4 级智能客服 Agent 系统</Text>

        <Text style={{ fontFamily: 'Times New Roman', fontSize: 23, color: '#3D7BD9', lineHeight: 1.5, marginTop: 10 }}>A Verifiable Execution Loop for High-Risk After-Sales Tasks</Text>

        <Box style={{ width: 140, height: 5, background: '#1E4FA8', borderRadius: 3, marginTop: 26 }} />

        <Box style={{ flexDirection: 'row', gap: 56, marginTop: 34 }}>
            <Box style={{ flexDirection: 'column', gap: 18 }}>
                <Box style={{ flexDirection: 'row', gap: 10 }}>
                    <Text style={{ fontSize: 20, color: '#8B97A8', width: 92 }}>汇报人</Text>
