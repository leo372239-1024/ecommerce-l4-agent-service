            </Box>
            <Box style={{ flexDirection: 'column', gap: 18 }}>
                <Box style={{ flexDirection: 'row', gap: 10 }}>
                    <Text style={{ fontSize: 20, color: '#8B97A8', width: 92 }}>小组成员</Text>
                    <Text style={{ fontSize: 22, color: '#1A2230' }}>王富祥 · 曹树桐 · 张藩</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 10 }}>
                    <Text style={{ fontSize: 20, color: '#8B97A8', width: 92 }}>专业方向</Text>
