<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', fontFamily: 'Microsoft YaHei', padding: '88px 40px 56px 40px' }}>
    {/* A 页眉 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 0 0 40px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', letterSpacing: 2 }}>网络计算与边缘智能 · 开题答辩</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#B9CDEA', marginRight: 22 }}>电商 L4 级智能客服 Agent 系统</Text>
            <Box style={{ width: 190, height: 64, background: '#FFFFFF', justifyContent: 'center', alignItems: 'center' }}>
                <Image src="assets/bjtu_logo.png" style={{ width: 166, height: 48, objectFit: 'contain' }} />
            </Box>
        </Box>
    </Box>

    {/* B 标题块 */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 40 }}>
        <Box style={{ width: 6, height: 34, background: '#1E4FA8', borderRadius: 3, marginRight: 12 }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>实验方案与评测协议</Text>
        <Text style={{ fontSize: 15, color: '#8B97A8', marginLeft: 'auto' }}>05 / 06</Text>
    </Box>

    {/* C 内容区 */}
    <Box style={{ flexDirection: 'column', gap: 12, marginTop: 16, height: 520 }}>
        {/* 冻结协议条 */}
        <Box style={{ height: 72, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: '0 22px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <FAIcon name='snowflake' style={{ fill: '#1E4FA8', width: 20, height: 20 }} />
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0E3F8C' }}>冻结协议</Text>
            <Text style={{ fontSize: 15, color: '#4A5568' }}>模型</Text>
            <Text style={{ fontSize: 15, color: '#1A2230', fontWeight: 'bold' }}>deepseek-v4.1-flash</Text>
            <Text style={{ fontSize: 15, color: '#4A5568' }}>·</Text>
            <Text style={{ fontSize: 15, color: '#1A2230', fontWeight: 'bold' }}>temperature 0.3</Text>
            <Text style={{ fontSize: 15, color: '#4A5568' }}>·</Text>
            <Text style={{ fontSize: 15, color: '#1A2230', fontWeight: 'bold' }}>reasoning 关闭</Text>
            <Text style={{ fontSize: 15, color: '#4A5568' }}>·</Text>
            <Text style={{ fontSize: 15, color: '#1A2230', fontWeight: 'bold' }}>provider 白名单 + fallback</Text>
            <Text style={{ fontSize: 15, color: '#4A5568' }}>·</Text>
            <Text style={{ fontSize: 15, color: '#1A2230', fontWeight: 'bold' }}>schedule 与评分器冻结</Text>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 20, height: 320 }}>
            {/* 左：基线与消融 */}
            <Box style={{ width: 700, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 24px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#0E3F8C' }}>基线与消融设计</Text>
                <Box style={{ flexDirection: 'column', gap: 8, marginTop: 14 }}>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'center', background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 6, padding: '8px 14px' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8', width: 96 }}>B2</Text>
                        <Text style={{ fontSize: 15, color: '#1A2230', flex: 1 }}>规划基线：原生 ReAct + BM25 / dense / RRF / reranker</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'center', background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 6, padding: '8px 14px' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8', width: 96 }}>R-hybrid</Text>
                        <Text style={{ fontSize: 15, color: '#1A2230', flex: 1 }}>路由基线：混合检索路由，用于 1000 项目录对照</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'center', background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 6, padding: '8px 14px' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8', width: 96 }}>M-vector</Text>
                        <Text style={{ fontSize: 15, color: '#1A2230', flex: 1 }}>记忆基线：最近 5 条对话 + 查询向量检索历史 Top8</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'center', background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 6, padding: '8px 14px' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8', width: 96 }}>A-reflect</Text>
                        <Text style={{ fontSize: 15, color: '#1A2230', flex: 1 }}>恢复基线：关闭证据反思，保留共享重试与 receipt 去重</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'center', background: '#FDF3F3', border: '1px solid #F3D6D6', borderRadius: 6, padding: '8px 14px' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#C0392B', width: 96 }}>A-plan</Text>
                        <Text style={{ fontSize: 15, color: '#1A2230', flex: 1 }}>规划消融：次级比较，用于分离机制贡献</Text>
                    </Box>
                </Box>
            </Box>

            {/* 右：评测口径 */}
            <Box style={{ width: 480, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 24px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#0E3F8C' }}>评测口径</Text>
                <Box style={{ flexDirection: 'column', gap: 6, marginTop: 10 }}>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8', width: 72 }}>严格成功</Text>
                        <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.5, flex: 1 }}>联合检查终态、订单作用域、当前证据、工具效果与回执等隐藏约束。</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8', width: 72 }}>统计方法</Text>
                        <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.5, flex: 1 }}>family 均衡率 + family 配对聚类 bootstrap（4000 次，seed 10001）。</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8', width: 72 }}>评测规模</Text>
                        <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.5, flex: 1 }}>七项冻结实验共 3762 个 schedule 单元，同一模型与参数。</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#D9534F', width: 72 }}>失败处理</Text>
                        <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.5, flex: 1 }}>失败批次与旧供应商结果原样保留，不删除、不更换分母。</Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* 局限条 */}
        <Box style={{ height: 100, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: '0 26px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                <FAIcon name='info-circle' style={{ fill: '#FFFFFF', width: 22, height: 22 }} />
            </Box>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>评测局限（如实披露）</Text>
                <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.55, marginTop: 2 }}>新题没有独立人工盲审；重复 trial 是同场景重复测量，不算新增独立样本；网关报告费用不是账单核对；外部模型 revision 不固定，不保证逐字一致。</Text>
            </Box>
        </Box>
    </Box>

    {/* D 页脚 */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 56, padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>北京交通大学 · 软件工程（专硕）</Text>
        <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>14 / 18</Text>
    </Box>
</Slide>
