<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', fontFamily: 'Microsoft YaHei', padding: '88px 40px 56px 40px' }}>
    {/* A 页眉 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 0 0 40px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', letterSpacing: 2 }}>网络计算与边缘智能 · 开题答辩</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#B9CDEA', marginRight: 22 }}>电商 L4 级智能客服 Agent 系统</Text>
            <Box style={{ width: 190, height: 64, background: '#FFFFFF', justifyContent: 'center', alignItems: 'center' }}>
                <Image src="assets/bjtu_logo.png" style={{ width: 166, height: 48, objectFit: 'contain' }} />
            </Box>
        </Box>
    </Box>

    {/* B 标题块 */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 40 }}>
        <Box style={{ width: 6, height: 34, background: '#1E4FA8', borderRadius: 3, marginRight: 12 }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>可行性分析</Text>
        <Text style={{ fontSize: 15, color: '#8B97A8', marginLeft: 'auto' }}>06 / 06</Text>
    </Box>

    {/* C 内容区 */}
    <Box style={{ flexDirection: 'column', gap: 12, marginTop: 16, height: 520 }}>
        {/* 两栏可行性 */}
        <Box style={{ flexDirection: 'row', gap: 20, height: 216 }}>
            <Box style={{ width: 590, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 24px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ width: 40, height: 40, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                        <FAIcon name='cogs' style={{ fill: '#1E4FA8', width: 20, height: 20 }} />
                    </Box>
                    <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#0E3F8C' }}>技术可行性</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6, marginTop: 12 }}>四项机制均已落地为可运行代码并留有验收证据；模型、Embedding 与 Reranker 使用真实 API，订单 / 仓库 / 财务为可审计的商家模拟系统。</Text>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8', marginTop: 'auto' }}>结论：技术路径已验证，非纸面设计</Text>
            </Box>

            <Box style={{ width: 590, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 24px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ width: 40, height: 40, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                        <FAIcon name='database' style={{ fill: '#1E4FA8', width: 20, height: 20 }} />
                    </Box>
                    <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#0E3F8C' }}>资源可行性</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6, marginTop: 12 }}>单机 Docker Compose 即可完整复现；依赖锁文件与镜像 digest 冻结；模型推理在远端，本机无需 GPU，3050 未承担 LLM 计算。</Text>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8', marginTop: 'auto' }}>结论：单机可复现，无专用硬件门槛</Text>
            </Box>
        </Box>

        {/* 风险与缓解表 */}
        <Box style={{ height: 196 }}>
            <Table
                style={{ width: '100%', height: '100%' }}
                defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#1A2230' }}
                defaultCellStyle={{
                    border: {
                        left: { width: 1, color: '#E5E7EB' },
                        right: { width: 1, color: '#E5E7EB' },
                        top: { width: 1, color: '#E5E7EB' },
                        bottom: { width: 1, color: '#E5E7EB' },
                    },
                }}
                cells={[
                    [
                        { text: '主要风险', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
                        { text: '影响', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
                        { text: '缓解措施', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
                    ],
                    ['外部模型 revision 漂移', '结果不可逐字复现', 'provider 白名单 + fallback；冻结 schedule 与评分器；披露 provider mix 差异'],
                    [
                        { text: '评测无独立人工盲审', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: '结论强度受限', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: '标注为探索性证据，未达标项如实交付、不修饰', cellStyle: { background: { color: '#F7F9FC' } } },
                    ],
                    ['单宿主单实例部署', '无跨故障域 HA', '明确交付边界；同宿主接管仅作工程演练，不外推为 HA'],
                    [
                        { text: '商家账本为模拟系统', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: '不能外推生产效果', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: '不宣称生产商家 SLA，真实商家接入列为后续项', cellStyle: { background: { color: '#F7F9FC' } } },
                    ],
                ]}
            />
        </Box>

        {/* 结论条 */}
        <Box style={{ height: 84, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: '0 26px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                <FAIcon name='balance-scale' style={{ fill: '#FFFFFF', width: 22, height: 22 }} />
            </Box>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>可行性判断</Text>
                <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.55, marginTop: 2 }}>技术上已实现并有证据链；资源上单机可复现；主要风险集中在外部模型漂移与评测强度，均已给出缓解手段与披露方式。</Text>
            </Box>
        </Box>
    </Box>

    {/* D 页脚 */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 56, padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>北京交通大学 · 软件工程（专硕）</Text>
        <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>16 / 18</Text>
    </Box>
</Slide>
