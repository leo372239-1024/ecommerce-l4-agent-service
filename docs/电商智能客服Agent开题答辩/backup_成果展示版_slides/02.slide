<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', padding: 0, flexDirection: 'row' }}>
    {/* 左侧深蓝导航栏（流式） */}
    <Box style={{ width: 380, height: 720, background: '#0E3F8C', flexDirection: 'column', justifyContent: 'center', padding: '0 48px' }}>
