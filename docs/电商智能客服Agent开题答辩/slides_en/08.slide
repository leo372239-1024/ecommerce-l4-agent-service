<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', fontFamily: 'Segoe UI', padding: '88px 40px 56px 40px' }}>
    {/* A header */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 0 0 40px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', letterSpacing: 2 }}>Network Computing and Edge Intelligence · Proposal Defense</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#B9CDEA', marginRight: 22 }}>L4 Intelligent Customer Service Agent for E-Commerce</Text>
            <Box style={{ width: 190, height: 64, background: '#FFFFFF', justifyContent: 'center', alignItems: 'center' }}>
                <Image src="assets/bjtu_logo.png" style={{ width: 166, height: 48, objectFit: 'contain' }} />
            </Box>
        </Box>
    </Box>

    {/* B title block */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 40 }}>
        <Box style={{ width: 6, height: 34, background: '#1E4FA8', borderRadius: 3, marginRight: 12 }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>Core Execution Loop</Text>
        <Text style={{ fontSize: 15, color: '#8B97A8', marginLeft: 'auto' }}>03 / 06</Text>
    </Box>

    {/* C content */}
    <Box style={{ flexDirection: 'column', gap: 12, marginTop: 16, height: 520 }}>
        {/* lead-in bar */}
        <Box style={{ height: 40, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 8, padding: '0 22px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <FAIcon name='route' style={{ fill: '#1E4FA8', width: 18, height: 18 }} />
            <Text style={{ fontSize: 15, color: '#1A2230' }}>A <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>seven-step controlled process</span> from task intake to human handover: every step has explicit entry conditions, evidence requirements and exit actions.</Text>
        </Box>

        {/* steps 1-4 */}
        <Box style={{ flexDirection: 'row', gap: 12, height: 190 }}>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '16px 18px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 30, height: 30, borderRadius: 15, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>1</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>Receive task</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55, marginTop: 10 }}>The session fixes customer, tenant and role; the API authorizes the resource and accepts idempotently.</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '16px 18px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 30, height: 30, borderRadius: 15, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>2</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>Parse &amp; plan</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55, marginTop: 10 }}>Parse into a TaskSpec, bind order and product entities, compile a verifiable DAG.</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '16px 18px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 30, height: 30, borderRadius: 15, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>3</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>Fetch current facts</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55, marginTop: 10 }}>Permission-filtered MCP tools read orders, logistics, policy and eligibility.</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '16px 18px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 30, height: 30, borderRadius: 15, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>4</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>Verify &amp; decide</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55, marginTop: 10 }}>Check goal coverage and evidence freshness; continue, refresh or hand over within budget.</Text>
            </Box>
        </Box>

        {/* steps 5-7 */}
        <Box style={{ flexDirection: 'row', gap: 12, height: 190 }}>
            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: '16px 18px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 30, height: 30, borderRadius: 15, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>5</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>Controlled write</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55, marginTop: 10 }}>Generate a proposal bound to the state version and amount; customer confirmation and supervisor approval are recorded separately, and the current version is re-read before execution.</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: '16px 18px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 30, height: 30, borderRadius: 15, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>6</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>Receipt reconciliation</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55, marginTop: 10 }}>Transactions carry idempotency keys; a lost response is reconciled via the operation receipt first, and non-idempotent writes are never replayed.</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: '16px 18px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 30, height: 30, borderRadius: 15, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>7</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>Persist &amp; recover</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55, marginTop: 10 }}>Business events go to PostgreSQL with SSE cursor resume; leases and fencing take over unfinished tasks.</Text>
            </Box>
        </Box>

        {/* conclusion bar */}
        <Box style={{ height: 56, background: '#0E3F8C', borderRadius: 10, padding: '0 24px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#3D7BD9' }}>Write-path principle</Text>
            <Text style={{ fontSize: 15, color: '#FFFFFF' }}>Success is never inferred from model text — it must match merchant transaction state and the operation receipt; if it cannot be confirmed, hand over to a human.</Text>
        </Box>
    </Box>

    {/* D footer */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 56, padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>Beijing Jiaotong University · Software Engineering (Professional Master)</Text>
        <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>08 / 18</Text>
    </Box>
</Slide>
