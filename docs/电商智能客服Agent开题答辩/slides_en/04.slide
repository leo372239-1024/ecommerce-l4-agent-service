<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', fontFamily: 'Segoe UI', padding: '88px 40px 56px 40px' }}>
    {/* A header */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 0 0 40px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', letterSpacing: 2 }}>Network Computing and Edge Intelligence · Proposal Defense</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#B9CDEA', marginRight: 22 }}>L4 Intelligent Customer Service Agent for E-Commerce</Text>
            <Box style={{ width: 190, height: 64, background: '#FFFFFF', justifyContent: 'center', alignItems: 'center' }}>
                <Image src="assets/bjtu_logo.png" style={{ width: 166, height: 48, objectFit: 'contain' }} />
            </Box>
        </Box>
    </Box>

    {/* B title block */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 40 }}>
        <Box style={{ width: 6, height: 34, background: '#1E4FA8', borderRadius: 3, marginRight: 12 }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>Related Work and the Engineering Capability Gap</Text>
        <Text style={{ fontSize: 15, color: '#8B97A8', marginLeft: 'auto' }}>01 / 06</Text>
    </Box>

    {/* C content */}
    <Box style={{ flexDirection: 'column', gap: 20, marginTop: 16, height: 520 }}>
        <Box style={{ flexDirection: 'row', gap: 20, height: 400 }}>
            {/* left: existing stack */}
            <Box style={{ width: 590, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 24px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <FAIcon name='layer-group' style={{ fill: '#3D7BD9', width: 20, height: 20 }} />
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>Existing Stack: Components Are Mature</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.6, marginTop: 8 }}>Open frameworks already make “call tools and answer” standard.</Text>

                <Box style={{ flexDirection: 'column', marginTop: 10 }}>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', paddingBottom: 8, borderBottom: '1px solid #E5E7EB' }}>
                        <FAIcon name='check-circle' style={{ fill: '#1E4FA8', width: 18, height: 18, marginTop: 2 }} />
                        <Box style={{ flex: 1 }}>
                            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230' }}>Planning &amp; Execution</Text>
                            <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.45, marginTop: 2 }}>ReAct tool calling, function calling, LangGraph checkpoints</Text>
                        </Box>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', paddingVertical: 8, borderBottom: '1px solid #E5E7EB' }}>
                        <FAIcon name='check-circle' style={{ fill: '#1E4FA8', width: 18, height: 18, marginTop: 2 }} />
                        <Box style={{ flex: 1 }}>
                            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230' }}>Retrieval Augmentation</Text>
                            <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.45, marginTop: 2 }}>BM25 lexical + vector semantic recall, RRF fusion, reranking</Text>
                        </Box>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', paddingVertical: 8, borderBottom: '1px solid #E5E7EB' }}>
                        <FAIcon name='check-circle' style={{ fill: '#1E4FA8', width: 18, height: 18, marginTop: 2 }} />
                        <Box style={{ flex: 1 }}>
                            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230' }}>Memory Mechanisms</Text>
                            <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.45, marginTop: 2 }}>Episodic / semantic / procedural memory, AWM templates</Text>
                        </Box>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', paddingVertical: 8, borderBottom: '1px solid #E5E7EB' }}>
                        <FAIcon name='check-circle' style={{ fill: '#1E4FA8', width: 18, height: 18, marginTop: 2 }} />
                        <Box style={{ flex: 1 }}>
                            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230' }}>Tool Protocol &amp; Gateway</Text>
                            <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.45, marginTop: 2 }}>MCP merchant interfaces; gateway authorization and validation</Text>
                        </Box>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start', paddingTop: 8 }}>
                        <FAIcon name='check-circle' style={{ fill: '#1E4FA8', width: 18, height: 18, marginTop: 2 }} />
                        <Box style={{ flex: 1 }}>
                            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1A2230' }}>Observability</Text>
                            <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.45, marginTop: 2 }}>OpenTelemetry → Jaeger / Prometheus / Grafana traces</Text>
                        </Box>
                    </Box>
                </Box>
            </Box>

            {/* right: capability gap */}
            <Box style={{ width: 590, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 24px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <FAIcon name='exclamation-triangle' style={{ fill: '#D9534F', width: 20, height: 20 }} />
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>Capability Gap: Missing Write Loop</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.6, marginTop: 8 }}>For refunds and cancellations, mature defaults break down.</Text>

                <Box style={{ flexDirection: 'column', gap: 10, marginTop: 14 }}>
                    <Box style={{ background: '#FDF3F3', borderLeft: '4px solid #D9534F', borderRadius: 8, padding: '10px 16px' }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#C0392B' }}>Evidence and authorization are not linked</Text>
                        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.6, marginTop: 4 }}>Stale summaries treated as current facts; old approvals persist.</Text>
                    </Box>
                    <Box style={{ background: '#FDF3F3', borderLeft: '4px solid #D9534F', borderRadius: 8, padding: '10px 16px' }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#C0392B' }}>Writes lack an idempotency boundary</Text>
                        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.6, marginTop: 4 }}>On timeout, commit status is unknown — duplicate refund risk.</Text>
                    </Box>
                    <Box style={{ background: '#FDF3F3', borderLeft: '4px solid #D9534F', borderRadius: 8, padding: '10px 16px' }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#C0392B' }}>Evaluation only checks the terminal state</Text>
                        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.6, marginTop: 4 }}>SUCCEEDED ≠ order scope, evidence and receipt all correct.</Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* bottom positioning statement */}
        <Box style={{ height: 100, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: '0 28px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                <FAIcon name='bullseye' style={{ fill: '#FFFFFF', width: 22, height: 22 }} />
            </Box>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>How this project is positioned</Text>
                <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.6, marginTop: 2 }}>We claim neither a domestic market void nor superiority over commercial products. The focus is to build the <span style={{ color: '#1E4FA8', fontWeight: 'bold' }}>verifiable execution loop</span> for high-risk after-sales tasks and to <span style={{ color: '#1E4FA8', fontWeight: 'bold' }}>quantify</span> its effects and limits item by item with a frozen simulated evaluation.</Text>
            </Box>
        </Box>
    </Box>

    {/* D footer */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 56, padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>Beijing Jiaotong University · Software Engineering (Professional Master)</Text>
        <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>04 / 18</Text>
    </Box>
</Slide>
