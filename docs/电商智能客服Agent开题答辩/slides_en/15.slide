<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', fontFamily: 'Segoe UI', padding: '88px 40px 56px 40px' }}>
    {/* A header */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 0 0 40px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', letterSpacing: 2 }}>Network Computing and Edge Intelligence · Proposal Defense</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#B9CDEA', marginRight: 22 }}>L4 Intelligent Customer Service Agent for E-Commerce</Text>
            <Box style={{ width: 190, height: 64, background: '#FFFFFF', justifyContent: 'center', alignItems: 'center' }}>
                <Image src="assets/bjtu_logo.png" style={{ width: 166, height: 48, objectFit: 'contain' }} />
            </Box>
        </Box>
    </Box>

    {/* B title block */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 40 }}>
        <Box style={{ width: 6, height: 34, background: '#1E4FA8', borderRadius: 3, marginRight: 12 }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>Expected Outcomes and Acceptance Metrics</Text>
        <Text style={{ fontSize: 15, color: '#8B97A8', marginLeft: 'auto' }}>05 / 06</Text>
    </Box>

    {/* C content */}
    <Box style={{ flexDirection: 'column', gap: 12, marginTop: 16, height: 520 }}>
        {/* expected outcome table */}
        <Box style={{ height: 304 }}>
            <Table
                style={{ width: '100%', height: '100%' }}
                defaultTextStyle={{ fontFamily: 'Segoe UI', fontSize: 15, textAlign: 'center', color: '#1A2230' }}
                defaultCellStyle={{
                    border: {
                        left: { width: 1, color: '#E5E7EB' },
                        right: { width: 1, color: '#E5E7EB' },
                        top: { width: 1, color: '#E5E7EB' },
                        bottom: { width: 1, color: '#E5E7EB' },
                    },
                }}
                cells={[
                    [
                        { text: 'Technical Direction', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
                        { text: 'Target', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
                        { text: 'Baseline', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
                        { text: 'Expected Gain', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
                        { text: 'Acceptance Method', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
                    ],
                    [
                        'Verifiable planning',
                        { text: 'Complex-task strict success ≥ 85%', textStyle: { bold: true, color: '#1E4FA8' } },
                        'Native ReAct + hybrid retrieval',
                        { text: '≥ +8pp', textStyle: { bold: true, color: '#1E4FA8' } },
                        '36 scenarios × 5 trials, family-balanced gap',
                    ],
                    [
                        { text: 'Authorized tool routing', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: 'No quality regression at 1,000 candidates', textStyle: { bold: true, color: '#1E4FA8' }, cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: 'Hybrid retrieval routing', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: '≥ 0pp (no regression)', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: '50 cases × 3 trials, permission and parameter checks', cellStyle: { background: { color: '#F7F9FC' } } },
                    ],
                    [
                        'Freshness-aware memory',
                        { text: 'Strict success ≥ 90%', textStyle: { bold: true, color: '#1E4FA8' } },
                        'Recent turns + vector history',
                        { text: '≥ +50pp; tokens −≥50%', textStyle: { bold: true, color: '#1E4FA8' } },
                        'Long-session suite, paired token accounting',
                    ],
                    [
                        { text: 'Reflection & failure recovery', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: 'Recoverable-failure success ≥ 90%', textStyle: { bold: true, color: '#1E4FA8' }, cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: 'Reflection-disabled baseline', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: '≥ +15pp', textStyle: { bold: true, color: '#1E4FA8' }, cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: 'Fault-family control; safe stops listed separately', cellStyle: { background: { color: '#F7F9FC' } } },
                    ],
                ]}
            />
        </Box>

        {/* scale and engineering acceptance */}
        <Box style={{ height: 92, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: '12px 26px', flexDirection: 'column', justifyContent: 'center', gap: 6 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 28 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
                    <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>≥ 3000</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568' }}>frozen evaluation units</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
                    <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>4</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568' }}>primary metrics + 4 baseline families</Text>
                </Box>
            </Box>
            <Text style={{ fontSize: 15, color: '#4A5568' }}>Engineering acceptance: all backend tests pass · 2 h continuous run, 0 failures · API P95 &lt; 1 s at 50 concurrency</Text>
        </Box>

        {/* acceptance principle bar */}
        <Box style={{ height: 100, background: '#0E3F8C', borderRadius: 10, padding: '0 26px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <FAIcon name='balance-scale' style={{ fill: '#3D7BD9', width: 26, height: 26 }} />
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>Acceptance Principle</Text>
                <Text style={{ fontSize: 16, color: '#B9CDEA', lineHeight: 1.55, marginTop: 2 }}>A terminal SUCCEEDED is not success: order scope, current evidence and the write receipt must be checked jointly; shortfalls are recorded honestly under pre-registered rules, without changing the denominator.</Text>
            </Box>
        </Box>
    </Box>

    {/* D footer */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 56, padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>Beijing Jiaotong University · Software Engineering (Professional Master)</Text>
        <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>15 / 18</Text>
    </Box>
</Slide>
