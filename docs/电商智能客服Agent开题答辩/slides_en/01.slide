    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 88, background: '#F7F9FC', borderTop: '1px solid #D6DCE5', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 44px' }}>
        <Text style={{ fontSize: 18, color: '#4A5568', letterSpacing: 1 }}>Beijing Jiaotong University · Software Engineering (Professional Master)</Text>
