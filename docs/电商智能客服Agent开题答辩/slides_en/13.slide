<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', fontFamily: 'Segoe UI', padding: '88px 40px 56px 40px' }}>
    {/* A header */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 0 0 40px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', letterSpacing: 2 }}>Network Computing and Edge Intelligence · Proposal Defense</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#B9CDEA', marginRight: 22 }}>L4 Intelligent Customer Service Agent for E-Commerce</Text>
            <Box style={{ width: 190, height: 64, background: '#FFFFFF', justifyContent: 'center', alignItems: 'center' }}>
                <Image src="assets/bjtu_logo.png" style={{ width: 166, height: 48, objectFit: 'contain' }} />
            </Box>
        </Box>
    </Box>

    {/* B title block */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 40 }}>
        <Box style={{ width: 6, height: 34, background: '#1E4FA8', borderRadius: 3, marginRight: 12 }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>Key Technology ④ Reflection &amp; Recovery</Text>
        <Box style={{ marginLeft: 'auto', padding: '4px 12px', background: '#E8EFF8', borderRadius: 12 }}><Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>Prior-pilot validation included</Text></Box><Text style={{ fontSize: 15, color: '#8B97A8', marginLeft: 14 }}>04 / 06</Text>
    </Box>

    {/* C content */}
    <Box style={{ flexDirection: 'column', gap: 12, marginTop: 16, height: 520 }}>
        {/* observation packet four fields */}
        <Box style={{ flexDirection: 'row', gap: 12, height: 72 }}>
            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 8, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>Source</Text>
                <Text style={{ fontSize: 15, color: '#4A5568' }}>Provenance traceable</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 8, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>Entity</Text>
                <Text style={{ fontSize: 15, color: '#4A5568' }}>Bound to order / item</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 8, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>Version</Text>
                <Text style={{ fontSize: 15, color: '#4A5568' }}>State versions comparable</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 8, padding: '0 18px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>Time</Text>
                <Text style={{ fontSize: 15, color: '#4A5568' }}>Freshness / schema check</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 20, height: 344 }}>
            {/* left: mechanism */}
            <Box style={{ width: 720, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 24px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <FAIcon name='sync-alt' style={{ fill: '#3D7BD9', width: 20, height: 20 }} />
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>Observation-Packet-Driven Reflection and Recovery</Text>
                </Box>
                <Box style={{ flexDirection: 'column', gap: 10, marginTop: 16 }}>
                    <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1E4FA8', width: 92 }}>Evidence<br />reflection</Text>
                        <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.5, flex: 1 }}>Deterministic evidence and business-contradiction checks come first; model suggestions can only narrow the action set, never widen permissions.</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1E4FA8', width: 92 }}>Change<br />awareness</Text>
                        <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.5, flex: 1 }}>A state change triggers evidence refresh and proposal invalidation; re-collected evidence must be re-confirmed.</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1E4FA8', width: 92 }}>Idempotent<br />writes</Text>
                        <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.5, flex: 1 }}>PostgreSQL unique constraints + legal state transitions + transactions + operation receipts together form the idempotency boundary.</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1E4FA8', width: 92 }}>Failure<br />takeover</Text>
                        <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.5, flex: 1 }}>Leases, fencing and LangGraph checkpoints ensure unfinished tasks are taken over rather than re-executed.</Text>
                    </Box>
                </Box>
            </Box>

            {/* right: data */}
            <Box style={{ width: 460, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 10, padding: '16px 22px', flexDirection: 'column' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>Pilot Validation<br />(Recoverable Failures)</Text>

                <Box style={{ marginTop: 6 }}>
                    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>144/144</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568', marginTop: 4 }}>Our approach P (100%)</Text>
                </Box>

                <Box style={{ marginTop: 6 }}>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#8B97A8', lineHeight: 1 }}>48/144</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568', marginTop: 4 }}>Baseline A-reflect (33.33%)</Text>
                </Box>

                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 10, marginTop: 8 }}>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#D9534F', lineHeight: 1 }}>+66.67pp</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568' }}>family-balanced gap</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', marginTop: 4 }}>95% CI [+33.33, +100]pp</Text>

                <Box style={{ marginTop: 'auto', background: '#F7F9FC', border: '1px solid #E5E7EB', borderRadius: 8, padding: '10px 14px' }}>
                    <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.5 }}>Safe stop under permanent failure is scored separately and excluded from this denominator.</Text>
                </Box>
            </Box>
        </Box>

        {/* conclusion bar */}
        <Box style={{ height: 80, background: '#0E3F8C', borderRadius: 10, padding: '0 24px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
            <FAIcon name='exclamation-circle' style={{ fill: '#3D7BD9', width: 24, height: 24 }} />
            <Text style={{ fontSize: 16, color: '#FFFFFF', lineHeight: 1.55 }}>Timeout <span style={{ color: '#FFC107', fontWeight: 'bold' }}>does not mean</span> “not written”: reconcile via the operation receipt first, and hand over if it cannot be confirmed; every loop is bounded by model requests, tokens, tool calls and wall-clock budgets.</Text>
        </Box>
    </Box>

    {/* D footer */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 56, padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>Beijing Jiaotong University · Software Engineering (Professional Master)</Text>
        <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>13 / 18</Text>
    </Box>
</Slide>
