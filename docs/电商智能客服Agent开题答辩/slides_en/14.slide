<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', fontFamily: 'Segoe UI', padding: '88px 40px 56px 40px' }}>
    {/* A header */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 0 0 40px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', letterSpacing: 2 }}>Network Computing and Edge Intelligence · Proposal Defense</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#B9CDEA', marginRight: 22 }}>L4 Intelligent Customer Service Agent for E-Commerce</Text>
            <Box style={{ width: 190, height: 64, background: '#FFFFFF', justifyContent: 'center', alignItems: 'center' }}>
                <Image src="assets/bjtu_logo.png" style={{ width: 166, height: 48, objectFit: 'contain' }} />
            </Box>
        </Box>
    </Box>

    {/* B title block */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 40 }}>
        <Box style={{ width: 6, height: 34, background: '#1E4FA8', borderRadius: 3, marginRight: 12 }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>Security, Permissions and Isolation</Text>
        <Text style={{ fontSize: 15, color: '#8B97A8', marginLeft: 'auto' }}>04 / 06</Text>
    </Box>

    {/* C content */}
    <Box style={{ flexDirection: 'column', gap: 12, marginTop: 16, height: 520 }}>
        {/* lead-in bar */}
        <Box style={{ height: 44, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 8, padding: '0 22px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <FAIcon name='lock' style={{ fill: '#1E4FA8', width: 18, height: 18 }} />
            <Text style={{ fontSize: 15, color: '#1A2230' }}>Four lines of defense: <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>transport, authorization, input and execution environment</span>, each narrowing what the model can affect.</Text>
        </Box>

        {/* four columns */}
        <Box style={{ flexDirection: 'row', gap: 16, height: 368 }}>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '14px 18px', flexDirection: 'column' }}>
                <Box style={{ width: 36, height: 36, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='key' style={{ fill: '#1E4FA8', width: 20, height: 20 }} />
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', marginTop: 8 }}>Session &amp; Transport<br />Security</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.55, marginTop: 6 }}>HttpOnly session cookies and CSRF checks; shared server sessions keep logins across API scale-out; OIDC validates issuer, audience, nonce, state, signature and PKCE.</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 10, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#D9534F', lineHeight: 1.45 }}>Demo accounts ≠ organizational IdP</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '14px 18px', flexDirection: 'column' }}>
                <Box style={{ width: 36, height: 36, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='user-shield' style={{ fill: '#1E4FA8', width: 20, height: 20 }} />
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', marginTop: 8 }}>Two-Layer<br />Authorization</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.55, marginTop: 6 }}>Casbin RBAC governs roles; owner / tenant ABAC governs data scope; customer identity comes from the server session, and the model cannot name the customer, tenant or approver.</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 10, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#D9534F', lineHeight: 1.45 }}>Permissions never come from model input</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '14px 18px', flexDirection: 'column' }}>
                <Box style={{ width: 36, height: 36, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='shield-alt' style={{ fill: '#1E4FA8', width: 20, height: 20 }} />
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', marginTop: 8 }}>Prompt Injection<br />Defense</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.55, marginTop: 6 }}>Text retrieved in conversation is treated as data only and cannot become trusted instructions or bypass authorization; logs, traces and guardrails maintain the trust boundary.</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 10, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#D9534F', lineHeight: 1.45 }}>No claim of immunity to unknown attacks</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 10, padding: '14px 18px', flexDirection: 'column' }}>
                <Box style={{ width: 36, height: 36, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='microchip' style={{ fill: '#1E4FA8', width: 20, height: 20 }} />
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', marginTop: 8 }}>Isolated Compute<br />Sandbox</Text>
                <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.55, marginTop: 6 }}>A separate sandbox container: no network, read-only root filesystem, CPU / memory / PID limits, Unix socket IPC; only quota computation, CSV summarization and text statistics are exposed.</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 10, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#D9534F', lineHeight: 1.45 }}>Arbitrary code execution disabled</Text>
                </Box>
            </Box>
        </Box>

        {/* boundary bar */}
        <Box style={{ height: 84, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: '0 26px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                <FAIcon name='info-circle' style={{ fill: '#FFFFFF', width: 22, height: 22 }} />
            </Box>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>Boundary Statement</Text>
                <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.55, marginTop: 2 }}>Local demo accounts and a test OIDC issuer are not an organizational production identity system; organizational IdP, production TLS and off-site encrypted backups are not validated on this machine.</Text>
            </Box>
        </Box>
    </Box>

    {/* D footer */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 56, padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>Beijing Jiaotong University · Software Engineering (Professional Master)</Text>
        <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>14 / 18</Text>
    </Box>
</Slide>
