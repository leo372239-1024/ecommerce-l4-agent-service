<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', fontFamily: 'Segoe UI', padding: '88px 40px 56px 40px' }}>
    {/* A header */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 0 0 40px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', letterSpacing: 2 }}>Network Computing and Edge Intelligence · Proposal Defense</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#B9CDEA', marginRight: 22 }}>L4 Intelligent Customer Service Agent for E-Commerce</Text>
            <Box style={{ width: 190, height: 64, background: '#FFFFFF', justifyContent: 'center', alignItems: 'center' }}>
                <Image src="assets/bjtu_logo.png" style={{ width: 166, height: 48, objectFit: 'contain' }} />
            </Box>
        </Box>
    </Box>

    {/* B title block */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 40 }}>
        <Box style={{ width: 6, height: 34, background: '#1E4FA8', borderRadius: 3, marginRight: 12 }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>Feasibility Analysis</Text>
        <Text style={{ fontSize: 15, color: '#8B97A8', marginLeft: 'auto' }}>06 / 06</Text>
    </Box>

    {/* C content */}
    <Box style={{ flexDirection: 'column', gap: 12, marginTop: 16, height: 520 }}>
        {/* two feasibility columns */}
        <Box style={{ flexDirection: 'row', gap: 20, height: 204 }}>
            <Box style={{ width: 590, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 24px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ width: 40, height: 40, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                        <FAIcon name='cogs' style={{ fill: '#1E4FA8', width: 20, height: 20 }} />
                    </Box>
                    <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#0E3F8C' }}>Technical Feasibility</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.6, marginTop: 12 }}>The team has prior-pilot work on all four mechanisms, each runnable with validation records; real models and retrieval APIs are retained, while the merchant side uses an auditable simulated system for reproducibility.</Text>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8', marginTop: 'auto' }}>Conclusion: grounded in prior-pilot evidence, not paper design</Text>
            </Box>

            <Box style={{ width: 590, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 24px', flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ width: 40, height: 40, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                        <FAIcon name='database' style={{ fill: '#1E4FA8', width: 20, height: 20 }} />
                    </Box>
                    <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#0E3F8C' }}>Resource Feasibility</Text>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.6, marginTop: 12 }}>A single machine with Docker Compose reproduces the whole system; lock files and image digests are frozen; inference runs remotely, so no local GPU is needed and the RTX 3050 carries no LLM computation.</Text>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8', marginTop: 'auto' }}>Conclusion: reproducible on one host, no special hardware</Text>
            </Box>
        </Box>

        {/* risk and mitigation table */}
        <Box style={{ height: 208 }}>
            <Table
                style={{ width: '100%', height: '100%' }}
                defaultTextStyle={{ fontFamily: 'Segoe UI', fontSize: 14, textAlign: 'left', color: '#1A2230' }}
                defaultCellStyle={{
                    border: {
                        left: { width: 1, color: '#E5E7EB' },
                        right: { width: 1, color: '#E5E7EB' },
                        top: { width: 1, color: '#E5E7EB' },
                        bottom: { width: 1, color: '#E5E7EB' },
                    },
                }}
                cells={[
                    [
                        { text: 'Key Risk', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
                        { text: 'Impact', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
                        { text: 'Mitigation', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#0E3F8C' } } },
                    ],
                    ['External model revision drift', 'Results not verbatim reproducible', 'Provider allowlist + fallback; frozen schedule and scorer; disclose provider-mix differences'],
                    [
                        { text: 'No independent human blind review', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: 'Limited strength of conclusions', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: 'Labelled exploratory evidence; shortfalls delivered as-is, unembellished', cellStyle: { background: { color: '#F7F9FC' } } },
                    ],
                    ['Single-host, single-instance deployment', 'No cross-failure-domain HA', 'Explicit delivery boundary; same-host takeover is an engineering drill only, not HA'],
                    [
                        { text: 'Merchant ledger is simulated', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: 'Production effects cannot be extrapolated', cellStyle: { background: { color: '#F7F9FC' } } },
                        { text: 'No claim of merchant production SLA; real merchant integration is future work', cellStyle: { background: { color: '#F7F9FC' } } },
                    ],
                ]}
            />
        </Box>

        {/* conclusion bar */}
        <Box style={{ height: 84, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: '0 26px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                <FAIcon name='balance-scale' style={{ fill: '#FFFFFF', width: 22, height: 22 }} />
            </Box>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>Feasibility Judgment</Text>
                <Text style={{ fontSize: 15, color: '#1A2230', lineHeight: 1.55, marginTop: 2 }}>Technically there is prior-pilot groundwork; resource-wise it reproduces on a single host; the main risks are external model drift and evaluation strength, each with mitigations and disclosure.</Text>
            </Box>
        </Box>
    </Box>

    {/* D footer */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 56, padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>Beijing Jiaotong University · Software Engineering (Professional Master)</Text>
        <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>16 / 18</Text>
    </Box>
</Slide>
