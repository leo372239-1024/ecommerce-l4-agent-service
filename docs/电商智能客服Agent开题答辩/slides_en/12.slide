<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', fontFamily: 'Segoe UI', padding: '88px 40px 56px 40px' }}>
    {/* A header */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 0 0 40px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', letterSpacing: 2 }}>Network Computing and Edge Intelligence · Proposal Defense</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#B9CDEA', marginRight: 22 }}>L4 Intelligent Customer Service Agent for E-Commerce</Text>
            <Box style={{ width: 190, height: 64, background: '#FFFFFF', justifyContent: 'center', alignItems: 'center' }}>
                <Image src="assets/bjtu_logo.png" style={{ width: 166, height: 48, objectFit: 'contain' }} />
            </Box>
        </Box>
    </Box>

    {/* B title block */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 40 }}>
        <Box style={{ width: 6, height: 34, background: '#1E4FA8', borderRadius: 3, marginRight: 12 }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>Key Technology ③ Freshness-Aware Memory</Text>
        <Box style={{ marginLeft: 'auto', padding: '4px 12px', background: '#E8EFF8', borderRadius: 12 }}><Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>Prior-pilot validation included</Text></Box><Text style={{ fontSize: 15, color: '#8B97A8', marginLeft: 14 }}>04 / 06</Text>
    </Box>

    {/* C content */}
    <Box style={{ flexDirection: 'column', gap: 12, marginTop: 16, height: 520 }}>
        {/* lead-in bar */}
        <Box style={{ height: 60, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 8, padding: '0 22px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <FAIcon name='brain' style={{ fill: '#1E4FA8', width: 20, height: 20 }} />
            <Text style={{ fontSize: 15, color: '#1A2230' }}>Context = an <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>owner-isolated entity ledger</span> + a bounded recent window + reference offloading + a token budget; memory serves reference resolution only, never facts or authorization.</Text>
        </Box>

        {/* three columns */}
        <Box style={{ flexDirection: 'row', gap: 15, height: 328 }}>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 22px', flexDirection: 'column' }}>
                <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='book' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
                </Box>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C', marginTop: 12 }}>Owner-Isolated Ledger</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.6, marginTop: 10 }}>The session entity ledger is isolated per owner and only resolves back-references such as “this item” or “the first order”; resolved entities still require a fresh read via current merchant tools.</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 12, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#D9534F' }}>The ledger itself grants no permissions</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 22px', flexDirection: 'column' }}>
                <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='compress-alt' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
                </Box>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C', marginTop: 12 }}>Reference Offload &amp; Budget</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.6, marginTop: 10 }}>Key fields are kept, historical references offloaded and a conservative token ceiling enforced; several entities may share one source span, rather than padding entity sentences to relax provenance checks.</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 12, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8' }}>Shared attributes reuse one source span</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 22px', flexDirection: 'column' }}>
                <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='sync-alt' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
                </Box>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C', marginTop: 12 }}>Non-Inheritance Principle</Text>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.6, marginTop: 10 }}>Stale amounts, business state and past approvals never become current facts or authorization; the merchant system is re-read before execution, and any state change invalidates the old proposal and approval.</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 12, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#D9534F' }}>Stale amounts and approvals never inherited</Text>
                </Box>
            </Box>
        </Box>

        {/* data bar */}
        <Box style={{ height: 108, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: '12px 26px', flexDirection: 'column', justifyContent: 'center', gap: 8 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 26 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
                    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>180/180</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568' }}>Our approach P (100%)</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#8B97A8', lineHeight: 1 }}>62/180</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568' }}>Baseline M-vector (task 34.44% / balanced 24.36%)</Text>
                </Box>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#D9534F' }}>+75.64pp</Text>
                <Text style={{ fontSize: 15, color: '#4A5568' }}>95% CI [+55.13, +92.31]pp</Text>
            </Box>
            <Text style={{ fontSize: 15, color: '#4A5568' }}>Conditional prompt tokens: <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>513,308 → 180,291 (−64.88%)</span>, covering only the 62 pairs correct in both arms; offline embedding cost excluded.</Text>
        </Box>
    </Box>

    {/* D footer */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 56, padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>Beijing Jiaotong University · Software Engineering (Professional Master)</Text>
        <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>12 / 18</Text>
    </Box>
</Slide>
