<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', fontFamily: 'Microsoft YaHei', padding: '88px 40px 56px 40px' }}>
    {/* A 页眉 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 0 0 40px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', letterSpacing: 2 }}>网络计算与边缘智能 · 开题答辩</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#B9CDEA', marginRight: 22 }}>电商 L4 级智能客服 Agent 系统</Text>
            <Box style={{ width: 190, height: 64, background: '#FFFFFF', justifyContent: 'center', alignItems: 'center' }}>
                <Image src="assets/bjtu_logo.png" style={{ width: 166, height: 48, objectFit: 'contain' }} />
            </Box>
        </Box>
    </Box>

    {/* B 标题块 */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 40 }}>
        <Box style={{ width: 6, height: 34, background: '#1E4FA8', borderRadius: 3, marginRight: 12 }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>项目主题与核心想法</Text>
        <Text style={{ fontSize: 15, color: '#8B97A8', marginLeft: 'auto' }}>02 / 06</Text>
    </Box>

    {/* C 内容区 */}
    <Box style={{ flexDirection: 'column', gap: 12, marginTop: 16, height: 520 }}>
        {/* 主题条 */}
        <Box style={{ height: 80, background: '#0E3F8C', borderRadius: 10, padding: '0 26px', flexDirection: 'row', alignItems: 'center', gap: 20 }}>
            <Box style={{ height: 30, padding: '0 12px', background: '#3D7BD9', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2 }}>项目主题</Text>
            </Box>
            <Text style={{ fontSize: 20, color: '#FFFFFF', lineHeight: 1.5 }}>面向电商高风险售后事务的<span style={{ color: '#FFC107', fontWeight: 'bold' }}>可验证执行闭环</span>—— 中文单 Agent 客服系统</Text>
        </Box>

        {/* 三个核心想法 */}
        <Box style={{ flexDirection: 'row', gap: 15, height: 320 }}>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 22px', flexDirection: 'column' }}>
                <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='clipboard-check' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
                </Box>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C', marginTop: 12 }}>从「能回答」到「能办完」</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6, marginTop: 10 }}>以「任务」而不是「对话轮次」为处理单元：先解析目标与实体，再编译带依赖关系的计划，最后以业务结果收口。</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 12, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8' }}>处理单元 = 任务</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 22px', flexDirection: 'column' }}>
                <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='fingerprint' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
                </Box>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C', marginTop: 12 }}>从「信任模型」到「信任证据」</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6, marginTop: 10 }}>会话记忆只用于指代解析；订单、物流、金额与资格等关键事实，每次执行前回商家系统重新读取，并带上来源与版本。</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 12, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8' }}>记忆不提供事实与授权</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 22px', flexDirection: 'column' }}>
                <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='file-signature' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
                </Box>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C', marginTop: 12 }}>从「调用接口」到「受控事务」</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6, marginTop: 10 }}>写操作按「提案 → 客户确认 → 主管审批 → 幂等执行 → 回执对账」五段式推进，任何一段缺失都不视为完成。</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 12, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8' }}>五段式受控写入</Text>
                </Box>
            </Box>
        </Box>

        {/* 差异化边界条 */}
        <Box style={{ height: 96, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: '0 26px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                <FAIcon name='bullseye' style={{ fill: '#FFFFFF', width: 22, height: 22 }} />
            </Box>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>差异化边界</Text>
                <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.55, marginTop: 2 }}>不宣称国内市场空白，也不宣称超越商业产品；落点是补齐高风险售后事务的<span style={{ color: '#1E4FA8', fontWeight: 'bold' }}>可验证执行闭环</span>，并以冻结模拟评测逐项量化效果与边界。</Text>
            </Box>
        </Box>
    </Box>

    {/* D 页脚 */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 56, padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>北京交通大学 · 软件工程（专硕）</Text>
        <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>05 / 18</Text>
    </Box>
</Slide>
