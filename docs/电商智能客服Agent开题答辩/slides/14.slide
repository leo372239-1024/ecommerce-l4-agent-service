<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', fontFamily: 'Microsoft YaHei', padding: '88px 40px 56px 40px' }}>
    {/* A 页眉 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 0 0 40px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', letterSpacing: 2 }}>网络计算与边缘智能 · 开题答辩</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Text style={{ fontSize: 14, color: '#B9CDEA', marginRight: 22 }}>电商 L4 级智能客服 Agent 系统</Text>
            <Box style={{ width: 190, height: 64, background: '#FFFFFF', justifyContent: 'center', alignItems: 'center' }}>
                <Image src="assets/bjtu_logo.png" style={{ width: 166, height: 48, objectFit: 'contain' }} />
            </Box>
        </Box>
    </Box>

    {/* B 标题块 */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 40 }}>
        <Box style={{ width: 6, height: 34, background: '#1E4FA8', borderRadius: 3, marginRight: 12 }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C' }}>安全、权限与隔离体系</Text>
        <Text style={{ fontSize: 15, color: '#8B97A8', marginLeft: 'auto' }}>04 / 06</Text>
    </Box>

    {/* C 内容区 */}
    <Box style={{ flexDirection: 'column', gap: 12, marginTop: 16, height: 520 }}>
        {/* 引导条 */}
        <Box style={{ height: 44, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 8, padding: '0 22px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <FAIcon name='lock' style={{ fill: '#1E4FA8', width: 18, height: 18 }} />
            <Text style={{ fontSize: 16, color: '#1A2230' }}>四条防线：从<span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>传输、授权、输入到执行环境</span>逐层收窄模型可影响的面。</Text>
        </Box>

        {/* 四栏 */}
        <Box style={{ flexDirection: 'row', gap: 16, height: 368 }}>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 20px', flexDirection: 'column' }}>
                <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='key' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', marginTop: 12 }}>会话与传输安全</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6, marginTop: 10 }}>HttpOnly 会话 Cookie 与 CSRF 校验；服务端共享会话使 API 扩容仍保持登录；OIDC 校验 issuer、audience、nonce、state、签名与 PKCE。</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 12, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#D9534F', lineHeight: 1.45 }}>演示账户 ≠ 组织 IdP 已接入</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 20px', flexDirection: 'column' }}>
                <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='user-shield' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', marginTop: 12 }}>双层授权模型</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6, marginTop: 10 }}>Casbin RBAC 管角色，资源拥有者 / 租户 ABAC 管数据范围；客户身份取自服务端会话，模型不能指定客户、租户或审批人。</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 12, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#D9534F', lineHeight: 1.45 }}>权限不来自模型输入</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 20px', flexDirection: 'column' }}>
                <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='shield-alt' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', marginTop: 12 }}>提示注入防护</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6, marginTop: 10 }}>对话中检索到的文本仅作数据处理，不能升级为可信指令或绕过授权；日志、Trace 与护栏共同维护信任边界。</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 12, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#D9534F', lineHeight: 1.45 }}>不宣称对未知攻击全免疫</Text>
                </Box>
            </Box>

            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 10, padding: '20px 20px', flexDirection: 'column' }}>
                <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#E8EFF8', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='microchip' style={{ fill: '#1E4FA8', width: 22, height: 22 }} />
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', marginTop: 12 }}>隔离计算沙箱</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.6, marginTop: 10 }}>独立 Sandbox 容器：无网络、只读根文件系统、CPU / 内存 / PID 限额、Unix socket 通信；仅开放定额计算、CSV 摘要与文本统计。</Text>
                <Box style={{ marginTop: 'auto', paddingTop: 12, borderTop: '1px solid #E5E7EB' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#D9534F', lineHeight: 1.45 }}>任意生成代码执行关闭</Text>
                </Box>
            </Box>
        </Box>

        {/* 边界条 */}
        <Box style={{ height: 84, background: '#F0F5FC', border: '1px solid #C9DCF5', borderRadius: 10, padding: '0 26px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Box style={{ width: 44, height: 44, borderRadius: 10, background: '#1E4FA8', justifyContent: 'center', alignItems: 'center' }}>
                <FAIcon name='info-circle' style={{ fill: '#FFFFFF', width: 22, height: 22 }} />
            </Box>
            <Box style={{ flex: 1 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>边界声明</Text>
                <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.55, marginTop: 2 }}>本地演示账户与测试 OIDC issuer 不等于组织生产身份系统；组织 IdP、生产 TLS 与异地加密备份未在本机验收。</Text>
            </Box>
        </Box>
    </Box>

    {/* D 页脚 */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 56, padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>北京交通大学 · 软件工程（专硕）</Text>
        <Text style={{ fontSize: 14, color: '#0E3F8C', fontWeight: 'bold' }}>14 / 18</Text>
    </Box>
</Slide>
