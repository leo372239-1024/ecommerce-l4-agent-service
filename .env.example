APP_ENV=development
AGENT_BACKEND_IMAGE=l4-agent-backend:stage10-final-v6
AGENT_WEB_IMAGE=l4-agent-web:stage10-final
LOG_LEVEL=INFO
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=agent
POSTGRES_DB=agent
REDIS_URL=redis://localhost:6380/0
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
# Historical ZHIPU_* names configure the OpenAI-compatible LLM (currently OpenRouter / DeepSeek V4.1 Flash).
ZHIPU_API_BASE=https://openrouter.ai/api/v1
ZHIPU_MODEL=deepseek/deepseek-v4.1-flash
LLM_TEMPERATURE=0.3
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-api/v1
DASHSCOPE_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
RERANKER_MODEL=qwen3-rerank
CONTEXT_ENGINEERING_ENABLED=false
CONTEXT_WINDOW_TOKENS=32768
CONTEXT_OUTPUT_RESERVE=2048
CONTEXT_TOOL_RESERVE=4096
CONTEXT_SAFETY_RESERVE=1024
SANDBOX_ENABLED=false
SANDBOX_SOCKET_PATH=/run/sandbox/broker.sock
SESSION_SECURE=false
# Production: configure all fixed HTTPS OIDC endpoints, HTTPS origins and secure cookies.
OIDC_ISSUER=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
CORS_ORIGINS=["http://localhost:5173"]
UPLOAD_MAX_FILE_BYTES=104857600
UPLOAD_MAX_REQUEST_BYTES=104857600
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Credentials live in .secrets/ and are mounted as Docker secrets.
